{
  "client_id": "https://favallc.github.io/photo-bluesky-oauth/client-metadata.json",
  "application_type": "native",
  "client_name": "EXIF Ramp",
  "redirect_uris": [
    "io.github.favallc:/oauth/callback"
  ],
  "grant_types": [
    "authorization_code",
    "refresh_token"
  ],
  "response_types": [
    "code"
  ],
  "scope": "atproto repo:app.bsky.feed.post?action=create blob:image/*",
  "token_endpoint_auth_method": "none",
  "dpop_bound_access_tokens": true
}
